# Copy this file to .env and fill in values as needed. All values here are optional;
# the pipeline runs fully locally without any of them set.

# Stamped on review-app label/notes edits for attribution. Also settable per-invocation
# via `review --reviewer you@example.com`.
REVIEWER_EMAIL=

# Only needed if you enable the optional SearXNG search backend
# (search.searxng.enabled: true) in your config -- point this at a SearXNG instance
# that has the JSON output format enabled for the /search endpoint.
SEARXNG_ENDPOINT_URL=

# Only needed if you enable the optional Ollama VLM backend (vlm.backend: ollama).
# Defaults to a local Ollama server if unset.
OLLAMA_BASE_URL=http://localhost:11434
